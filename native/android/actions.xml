<?xml version="1.0" encoding="utf-8"?>
<!--
  LOKIN AI — Google Assistant App Actions (capability.xml)
  Reference implementation. Port into your Android Studio project at:
    app/src/main/res/xml/actions.xml
  and reference it from AndroidManifest.xml <application>:
    <meta-data android:name="com.google.actions" android:resource="@xml/actions"/>

  Each <action> maps a spoken query pattern to a deep link the native shell
  loads in its WebView. The LOKIN React app reads ?via=assistant and
  surfaces a brief acknowledgment.

  Published production domain: https://lokin-ai-app-604c3139.base44.app
  (the same one exposed at /api/mcp).
-->
<actions>
    <!-- "Hey Google, open my LOKIN route" / "optimize my LOKIN route" -->
    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_route_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/route?action=route&amp;via=assistant">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>

    <!-- "Hey Google, ask LOKIN" -->
    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_assistant_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/lokin?action=lokin&amp;via=assistant">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>

    <!-- "Hey Google, show my LOKIN earnings" -->
    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_earnings_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/earnings?action=earnings&amp;via=assistant">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>

    <!--
      Hands-free shift control — each routes through /command so the React
      CommandIngress + lokinCommandPolicy can validate and confirm the action
      (mirrors the iOS App Intents). Tap Out stays explicit, not silent.
    -->
    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_lockin_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/command?command=lock_in&amp;source=assistant&amp;v=1">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>

    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_pause_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/command?command=pause&amp;source=assistant&amp;v=1">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>

    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_resume_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/command?command=resume&amp;source=assistant&amp;v=1">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>

    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_tapout_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/command?command=tap_out&amp;source=assistant&amp;v=1">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>

    <action intentName="actions.intent.OPEN_APP_FEATURE"
            queryPatterns="@array/lokin_finditem_queries">
        <parameter name="lokin.feature">
            <entity-set-reference entitySetId="lokinFeatureEntitySet" />
        </parameter>
        <fulfillment urlTemplate="https://lokin-ai-app-604c3139.base44.app/command?command=find_item&amp;source=assistant&amp;v=1">
            <parameter-mapping urlParameter="lokin.feature" intentParameter="lokin.feature" />
        </fulfillment>
    </action>
</actions>