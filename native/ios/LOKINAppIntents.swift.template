// Tap Out intentionally opens LOKIN for explicit confirmation; the deep-link policy will not silently end a session.
struct TapOutIntent: AppIntent {
    static var title: LocalizedStringResource = "Tap Out with LOKIN"
    static var openAppWhenRun = true
    func perform() async throws -> some IntentResult & OpensIntent { .result(opensIntent: OpenURLIntent(lokinURL(.tapOut))) }
}

struct LokinShortcuts: AppShortcutsProvider {
    static var appShortcuts: [AppShortcut] {
        AppShortcut(intent: LockInIntent(), phrases: ["Level up with \(.applicationName)", "Lock in with \(.applicationName)"], shortTitle: "Lock In", systemImageName: "lock.fill")
        AppShortcut(intent: PauseLokinIntent(), phrases: ["Pause \(.applicationName)"], shortTitle: "Pause", systemImageName: "pause.fill")
        AppShortcut(intent: ResumeLokinIntent(), phrases: ["Resume \(.applicationName)"], shortTitle: "Resume", systemImageName: "play.fill")
        AppShortcut(intent: FindItemIntent(), phrases: ["Find item with \(.applicationName)"], shortTitle: "Find Item", systemImageName: "barcode.viewfinder")
        AppShortcut(intent: TapOutIntent(), phrases: ["Tap out with \(.applicationName)"], shortTitle: "Tap Out", systemImageName: "power")
    }
}
