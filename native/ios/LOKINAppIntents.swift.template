// LOKIN iOS native bridge template — copy into the generated Xcode target.
// Requires AppIntents and the app's verified universal-link domain.
import AppIntents

private enum LokinCommand: String {
    case lockIn = "lock_in", pause, resume, tapOut = "tap_out"
    case findItem = "find_item", smartShop = "smart_shop", openRoute = "open_route", safety
}

private func lokinURL(_ command: LokinCommand) -> URL {
    // Replace with the production HTTPS LOKIN associated domain.
    var c = URLComponents(string: "https://lokin-ai-app-604c3139.base44.app/command")!
    c.queryItems = [
        URLQueryItem(name: "command", value: command.rawValue),
        URLQueryItem(name: "source", value: "siri"),
        URLQueryItem(name: "v", value: "1")
    ]
    return c.url!
}

struct LockInIntent: AppIntent {
    static var title: LocalizedStringResource = "Lock In"
    static var description = IntentDescription("Start working with LOKIN and open focused AI GPS.")
    static var openAppWhenRun = true
    func perform() async throws -> some IntentResult & OpensIntent {
        .result(opensIntent: OpenURLIntent(lokinURL(.lockIn)))
    }
}

struct PauseLokinIntent: AppIntent {
    static var title: LocalizedStringResource = "Pause LOKIN"
    func perform() async throws -> some IntentResult & OpensIntent { .result(opensIntent: OpenURLIntent(lokinURL(.pause))) }
}

struct ResumeLokinIntent: AppIntent {
    static var title: LocalizedStringResource = "Resume LOKIN"
    func perform() async throws -> some IntentResult & OpensIntent { .result(opensIntent: OpenURLIntent(lokinURL(.resume))) }
}

struct FindItemIntent: AppIntent {
