// LOKIN Native Voice Bridge — iOS reference implementation.
// Port into the real Xcode native shell that hosts the LOKIN WKWebView.
//
// Architecture:
//   foreground voice -> Apple Speech -> wake/command parse -> WKWebView bridge
//   background / locked device -> Siri App Intents -> verified /command Universal Link
//
// iOS does not provide arbitrary third-party apps a system-level custom wake word
// while suspended. "Hey LOKIN" can be active while the app is foregrounded and
// audio capture is running. Outside that state, use Siri/App Shortcuts.

import AVFoundation
import Speech
import WebKit

@MainActor
final class LOKINNativeVoiceBridge: NSObject, WKScriptMessageHandler {
    private weak var webView: WKWebView?
    private let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US"))
    private let audioEngine = AVAudioEngine()
    private var recognitionRequest: SFSpeechAudioBufferRecognitionRequest?
    private var recognitionTask: SFSpeechRecognitionTask?
    private var wakeMode = false
    private let wakePattern = try! NSRegularExpression(pattern: #"\bhey\s+(?:lokin|lock\s*in)\b"#, options: [.caseInsensitive])

    init(webView: WKWebView) {
        self.webView = webView
        super.init()
        webView.configuration.userContentController.add(self, name: "lokinVoice")
    }

    deinit {
        webView?.configuration.userContentController.removeScriptMessageHandler(forName: "lokinVoice")
    }

    func requestPermissions() async -> Bool {
        let speech = await withCheckedContinuation { continuation in
            SFSpeechRecognizer.requestAuthorization { continuation.resume(returning: $0) }
        }
        guard speech == .authorized else { return false }
        return await AVAudioApplication.requestRecordPermission()
    }

    func userContentController(_ userContentController: WKUserContentController, didReceive message: WKScriptMessage) {
        guard message.name == "lokinVoice", let body = message.body as? [String: Any], let type = body["type"] as? String else { return }
        switch type {
        case "startWake": startListening(wake: true)
        case "stopWake": stopListening()
        case "startCommand": startListening(wake: false)
        case "webReady": sendStatus(state: "ready")
        default: break
        }
    }

    func startListening(wake: Bool) {
        Task {
            guard await requestPermissions() else {
                sendStatus(state: "permission-denied")
                return
            }
            stopListening()
            wakeMode = wake
            let request = SFSpeechAudioBufferRecognitionRequest()
            request.shouldReportPartialResults = true
            recognitionRequest = request

            let input = audioEngine.inputNode
            let format = input.outputFormat(forBus: 0)
            input.installTap(onBus: 0, bufferSize: 1024, format: format) { [weak request] buffer, _ in
                request?.append(buffer)
            }

            recognitionTask = recognizer?.recognitionTask(with: request) { [weak self] result, error in
                guard let self else { return }
                if let result {
                    Task { @MainActor in self.handleTranscript(result.bestTranscription.formattedString, isFinal: result.isFinal) }
                }
                if error != nil { Task { @MainActor in self.restartIfNeeded() } }
            }

            do {
                audioEngine.prepare()
                try audioEngine.start()
                sendStatus(state: wake ? "wake-listening" : "command-listening")
            } catch {
                sendStatus(state: "audio-error")
                stopListening()
            }
        }
    }

    func stopListening() {
        recognitionTask?.cancel()
        recognitionTask = nil
        recognitionRequest?.endAudio()
        recognitionRequest = nil
        if audioEngine.isRunning { audioEngine.stop() }
        audioEngine.inputNode.removeTap(onBus: 0)
    }

    private func handleTranscript(_ text: String, isFinal: Bool) {
        if wakeMode {
            let range = NSRange(text.startIndex..<text.endIndex, in: text)
            guard let match = wakePattern.firstMatch(in: text, range: range), let swiftRange = Range(match.range, in: text) else { return }
            let trailing = String(text[swiftRange.upperBound...]).trimmingCharacters(in: .whitespacesAndNewlines.union(.punctuationCharacters))
            if !trailing.isEmpty {
                stopListening()
                sendCommand(transcript: trailing)
            } else {
                sendStatus(state: "wake-heard")
                stopListening()
                startListening(wake: false)
            }
        } else if isFinal {
            let cleaned = text.replacingOccurrences(of: #"^hey\s+(?:lokin|lock\s*in)[,.!?\s-]*"#, with: "", options: [.regularExpression, .caseInsensitive])
            stopListening()
            sendCommand(transcript: cleaned.isEmpty ? text : cleaned)
        }
    }

    private func restartIfNeeded() {
        let shouldWake = wakeMode
        stopListening()
        if shouldWake { DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { self.startListening(wake: true) } }
    }

    private func sendCommand(transcript: String) {
        let payload: [String: Any] = ["commandId": "ask", "transcript": transcript]
        guard let data = try? JSONSerialization.data(withJSONObject: payload), let json = String(data: data, encoding: .utf8) else { return }
        webView?.evaluateJavaScript("window.LOKINNativeVoice?.receive(\(json));")
    }

    private func sendStatus(state: String) {
        let payload = "{\"available\":true,\"state\":\"\(state)\"}"
        webView?.evaluateJavaScript("window.LOKINNativeVoice?.status(\(payload));")
    }
}
