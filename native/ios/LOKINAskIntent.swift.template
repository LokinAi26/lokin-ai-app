// Ask LOKIN from Siri / Shortcuts. Port into the real iOS target.
import AppIntents

@available(iOS 16.0, *)
struct AskLokinIntent: AppIntent {
    static var title: LocalizedStringResource = "Ask LOKIN"
    static var description = IntentDescription("Send a spoken question to the LOKIN copilot.")
    static var openAppWhenRun = true

    @Parameter(title: "Question")
    var question: String

    func perform() async throws -> some IntentResult & OpensIntent {
        var c = URLComponents(string: "https://lokin-ai-app-604c3139.base44.app/command")!
        c.queryItems = [
            URLQueryItem(name: "command", value: "ask"),
            URLQueryItem(name: "source", value: "siri"),
            URLQueryItem(name: "v", value: "1"),
            URLQueryItem(name: "q", value: String(question.prefix(120)))
        ]
        return .result(opensIntent: OpenURLIntent(c.url!))
    }
}

@available(iOS 16.0, *)
struct AskLokinShortcuts: AppShortcutsProvider {
    static var appShortcuts: [AppShortcut] {
        AppShortcut(
            intent: AskLokinIntent(),
            phrases: [
                "Ask \(.applicationName) \(.$question)",
                "Tell \(.applicationName) \(.$question)"
            ],
            shortTitle: "Ask LOKIN",
            systemImageName: "waveform.badge.mic"
        )
    }
}
