{
  "name": "OasisProductionJob",
  "type": "object",
  "description": "Auditable queued execution job for the OASIS Production Fabric",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "workflow_definition_id": {
      "type": "string"
    },
    "workflow_key": {
      "type": "string"
    },
    "workflow_version": {
      "type": "integer",
      "minimum": 1
    },
    "requested_capability": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_approval",
        "setup_required",
        "queued",
        "running",
        "qc",
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ],
      "default": "draft"
    },
    "input_json": {
      "type": "string"
    },
    "output_json": {
      "type": "string"
    },
    "input_asset_hashes_json": {
      "type": "string"
    },
    "estimated_cost_usd": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "reserved_cost_usd": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "actual_cost_usd": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "credit_guardian_decision": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "attempt_count": {
      "type": "integer",
      "default": 0,
      "minimum": 0
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_user_id",
    "project_id",
    "workflow_key",
    "workflow_version",
    "requested_capability",
    "status",
    "idempotency_key",
    "created_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}