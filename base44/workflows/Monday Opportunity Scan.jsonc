{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monday_opportunity_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanOpportunities",
            "args": {
              "scheduled": true,
              "mode": "jobs",
              "internal_job_key": "REPLACE_WITH_LOKIN_INTERNAL_JOB_KEY"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run Hampton Roads scan",
            "description": "Live verification scan for current delivery & courier openings"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Monday Opportunity Scan",
  "description": "Weekly backup scan that live-verifies current Hampton Roads delivery & courier openings. App pages also refresh on demand and hide expired/unverified records."
}