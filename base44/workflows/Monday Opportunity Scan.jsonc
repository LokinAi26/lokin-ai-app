{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monday_opportunity_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_jobs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanOpportunities",
            "args": {
              "scheduled": true,
              "mode": "jobs",
              "internal_job_key": "REPLACE_WITH_LOKIN_INTERNAL_JOB_KEY"
            }
          },
          "then": "scan_gigs",
          "x-base44": {
            "title": "Run Hampton Roads jobs scan",
            "description": "Live verification scan for current delivery & courier openings"
          }
        }
      },
      {
        "scan_gigs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanOpportunities",
            "args": {
              "scheduled": true,
              "mode": "gigs",
              "internal_job_key": "REPLACE_WITH_LOKIN_INTERNAL_JOB_KEY"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run Hampton Roads gigs scan",
            "description": "Live verification scan for mystery shop, food review, product test & paid research gigs"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Monday Opportunity Scan",
  "description": "Daily auto-scan that live-verifies current Hampton Roads gig opportunities \u2014 delivery/courier jobs plus mystery shopping, food review, product testing and paid research. App pages also refresh on demand and hide expired/unverified records."
}