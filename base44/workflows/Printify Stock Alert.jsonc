{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "printify_stock_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_stock": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "printify-stock-alert"
          },
          "then": "end",
          "x-base44": {
            "title": "Scan Printify stock",
            "description": "Alert owner on low variants"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Printify Stock Alert",
  "description": "Scans the Printify catalog daily at 9am local time and emails the app owner when branded items drop below the low-stock threshold."
}