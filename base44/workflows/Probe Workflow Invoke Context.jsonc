{
  "name": "Probe Workflow Invoke Context",
  "description": "TEMPORARY diagnostic: invokes internal-call-probe on a short recurring schedule to capture the auth/header context of workflow-invoked function calls. Delete after diagnosis.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "probe_workflow_invoke_context",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "probe": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "internal-call-probe",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Probe call context",
            "description": "Reports auth and header context of this invocation"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "timezone": "UTC",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}