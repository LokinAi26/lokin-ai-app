{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_driver_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weekly-driver-report"
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly driver report",
            "description": "Mileage, tax savings, session earnings email"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 18 * * 0",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Weekly Driver Report",
  "description": "Emails the driver's weekly mileage, total tax savings, and session earnings summary every Sunday at 6pm local time."
}