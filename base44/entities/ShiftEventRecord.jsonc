{"description":"Server-side copy of a client shift event, keyed by immutable eventId. Written only by the syncShiftEvents backend function (service role) for idempotent event ingestion per SPEC-001 Method §6 + I5. M1: observational sync only; never read by product UI.","name":"ShiftEventRecord","properties":{"driver_id":{"description":"Owning driver (Base44 user id).","type":"string"},"event_id":{"description":"Immutable client-generated event UUID. The idempotency key: re-submitted batches with an already-stored event_id are acknowledged as already-present, never duplicated.","type":"string"},"occurred_at":{"format":"date-time","type":"string"},"origin":{"enum":["DEVICE","BACKEND"],"type":"string"},"payload":{"description":"Validated event payload as submitted.","type":"object"},"recorded_at":{"format":"date-time","type":"string"},"sequence_number":{"description":"Monotonic sequence within the shift.","type":"number"},"session_id":{"description":"Client session that produced the event.","type":"string"},"shift_id":{"description":"Canonical shift identifier (driver:YYYY-MM-DD day bucket).","type":"string"},"source":{"description":"Producing seam, e.g. lock-in-seam.","type":"string"},"type":{"description":"Frozen ShiftEventType, e.g. SESSION_STARTED.","type":"string"}},"required":["event_id","shift_id","session_id","driver_id","type"],"rls":{"create":{"user_condition":{"role":"admin"}},"delete":{"user_condition":{"role":"admin"}},"read":{"user_condition":{"role":"admin"}},"update":{"user_condition":{"role":"admin"}}},"type":"object"}