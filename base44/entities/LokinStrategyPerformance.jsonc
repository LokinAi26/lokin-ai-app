{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "strategy_key": {
      "type": "string"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "wins": {
      "type": "integer",
      "minimum": 0
    },
    "losses": {
      "type": "integer",
      "minimum": 0
    },
    "avg_net_per_hour": {
      "type": "number"
    },
    "avg_dollars_per_mile": {
      "type": "number"
    },
    "avg_success_score": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rank_score": {
      "type": "number"
    },
    "last_outcome_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "strategy_key"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "LokinStrategyPerformance"
}