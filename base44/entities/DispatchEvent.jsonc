{
  "name": "DispatchEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "load_id": {
      "type": "string"
    },
    "assignment_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "load_seen",
        "load_accepted",
        "load_rejected",
        "en_route_pickup",
        "picked_up",
        "in_transit",
        "delivered",
        "hos_block",
        "route_block",
        "profile_updated",
        "vehicle_updated",
        "hos_updated",
        "exception"
      ],
      "default": "load_seen"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "message": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_id",
    "event_type",
    "occurred_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}