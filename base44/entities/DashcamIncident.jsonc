{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "marked_at": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "local_clip_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "marked",
        "saved_local",
        "exported",
        "deleted"
      ]
    }
  },
  "required": [
    "user_id",
    "marked_at",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "DashcamIncident"
}