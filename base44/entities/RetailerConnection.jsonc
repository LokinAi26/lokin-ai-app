{
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string"
    },
    "retailer_name": {
      "type": "string"
    },
    "integration_type": {
      "type": "string",
      "enum": [
        "official_api",
        "merchant_feed",
        "shopify",
        "manual_layout",
        "partner"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "connected",
        "degraded",
        "disabled"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inventory_verified": {
      "type": "boolean"
    },
    "layout_verified": {
      "type": "boolean"
    },
    "last_sync_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "retailer_name",
    "integration_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "RetailerConnection"
}