{
  "name": "OasisApproval",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "enum": [
        "brand",
        "rights",
        "production",
        "sample",
        "storefront",
        "campaign",
        "spend"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "changes_requested"
      ],
      "default": "pending"
    },
    "reviewer_user_id": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "gate",
    "decision"
  ]
}