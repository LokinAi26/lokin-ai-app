{
  "name": "AgentExecutionSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "FROZEN",
        "REVOKED",
        "COMPLETED",
        "EXPIRED"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "budgets": {
      "type": "object"
    },
    "granted_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freeze_reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "session_id",
    "owner_user_id",
    "agent_id",
    "status",
    "created_at"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}