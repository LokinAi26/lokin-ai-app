{
  "name": "OpportunityAlert",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The driver this in-app alert is for."
    },
    "opportunity_id": {
      "type": "string",
      "description": "Reference to the OpportunityScan record that matched."
    },
    "opportunity_title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "pay": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "match_reason": {
      "type": "string",
      "description": "Human-readable reason this opportunity matched the driver (region + vehicle)."
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "emailed": {
      "type": "boolean",
      "default": false,
      "description": "True when an email notification was successfully sent for this alert."
    }
  },
  "required": [
    "user_id",
    "opportunity_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}