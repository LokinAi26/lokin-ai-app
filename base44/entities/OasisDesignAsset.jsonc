{
  "name": "OasisDesignAsset",
  "type": "object",
  "description": "Versioned OASIS creative and production asset",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "concept",
        "graphic",
        "mockup",
        "packaging",
        "print_file",
        "product_spec",
        "campaign"
      ]
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "default": 1
    },
    "file_url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "rejected",
        "archived"
      ],
      "default": "draft"
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "clear",
        "blocked"
      ],
      "default": "unreviewed"
    },
    "production_ready": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "asset_type",
    "name",
    "version"
  ]
}