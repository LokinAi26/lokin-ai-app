{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "exercise": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "reps_observed": {
      "type": "number"
    },
    "form_score": {
      "type": "number"
    },
    "tempo_score": {
      "type": "number"
    },
    "range_score": {
      "type": "number"
    },
    "stability_score": {
      "type": "number"
    },
    "coaching_cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "camera",
        "wearable",
        "lokin"
      ]
    },
    "feedback_rating": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "exercise"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "FitnessFormSession"
}