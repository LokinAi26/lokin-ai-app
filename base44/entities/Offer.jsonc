{
  "name": "Offer",
  "type": "object",
  "properties": {
    "merchant": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food_pickup",
        "grocery_shop_deliver",
        "grocery_pickup",
        "retail",
        "package",
        "alcohol",
        "pharmacy"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "doordash",
        "uber_eats",
        "instacart",
        "spark",
        "shipt",
        "grubhub",
        "amazon_flex",
        "roadie",
        "other"
      ],
      "default": "other",
      "description": "Delivery platform named by the authenticated user or official source. LOKIN does not infer platform affiliation."
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owning LOKIN user for private account/user-derived offers."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "market"
      ],
      "default": "private",
      "description": "Private offers are visible only to their owning driver; market offers are explicitly shareable feed records."
    },
    "provider_event_id": {
      "type": "string",
      "description": "Idempotent event identifier supplied by an authorized provider adapter."
    },
    "provider_sync_id": {
      "type": "string",
      "description": "Synchronization batch/run identifier from an authorized provider adapter."
    },
    "source_account_id": {
      "type": "string",
      "description": "Provider-side account reference for private authorized data; never an OAuth token or secret."
    },
    "source_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "When LOKIN received this record from the source channel."
    },
    "payout": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "miles": {
      "type": "number"
    },
    "est_minutes": {
      "type": "number"
    },
    "pickup_address": {
      "type": "string"
    },
    "dropoff_address": {
      "type": "string"
    },
    "state_code": {
      "type": "string",
      "description": "Two-letter state verified from the pickup address by the server-side map provider."
    },
    "postal_code": {
      "type": "string",
      "description": "Pickup postal code verified from the geocoding response."
    },
    "region": {
      "type": "string",
      "description": "Verified operating market label, initially Virginia / Hampton Roads."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "user_entered",
        "user_shared",
        "official_api",
        "merchant_feed"
      ],
      "description": "Provenance of the offer. Scraped or inferred platform offers are not accepted."
    },
    "source_reference": {
      "type": "string",
      "description": "Optional external reference supplied by an authorized source."
    },
    "source_disclosure": {
      "type": "string",
      "description": "Plain-language disclosure of what was and was not independently verified."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "address_verified",
        "platform_verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current offer was observed."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "After this time the offer is excluded from routing and hotspots."
    },
    "capture_id": {
      "type": "string",
      "description": "Client-generated idempotency key preventing duplicate offer ingestion."
    },
    "store_hours": {
      "type": "string",
      "description": "Merchant pickup location operating hours, e.g. '7AM-11PM' or '07:00-23:00'."
    },
    "items_count": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "accepted",
        "completed",
        "declined"
      ],
      "default": "available"
    },
    "sequence": {
      "type": "number"
    }
  },
  "required": [
    "merchant",
    "category",
    "payout",
    "miles",
    "est_minutes"
  ]
}