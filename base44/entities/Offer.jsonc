{
  "name": "Offer",
  "type": "object",
  "properties": {
    "merchant": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food_pickup",
        "grocery_shop_deliver",
        "grocery_pickup",
        "retail",
        "package",
        "alcohol",
        "pharmacy"
      ]
    },
    "payout": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "miles": {
      "type": "number"
    },
    "est_minutes": {
      "type": "number"
    },
    "pickup_address": {
      "type": "string"
    },
    "dropoff_address": {
      "type": "string"
    },
    "store_hours": {
      "type": "string",
      "description": "Merchant pickup location operating hours, e.g. '7AM-11PM' or '07:00-23:00'. Shown on route stops so drivers know closing/opening times."
    },
    "items_count": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "accepted",
        "completed",
        "declined"
      ],
      "default": "available"
    },
    "sequence": {
      "type": "number"
    }
  },
  "required": [
    "merchant",
    "category",
    "payout",
    "miles",
    "est_minutes"
  ]
}