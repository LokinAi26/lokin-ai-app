{
  "name": "DriverCertification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "program": {
      "type": "string",
      "enum": [
        "cannabis_training",
        "alcohol_training",
        "tobacco_nicotine_training"
      ],
      "default": "cannabis_training"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "passed",
        "expired",
        "suspended"
      ],
      "default": "not_started"
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "certificate_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "eligible_for_regulated_offers": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "program",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}