{
  "name": "LocatorItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "item_code": {
      "type": "string"
    },
    "aisle": {
      "type": "string"
    },
    "shelf": {
      "type": "string"
    },
    "store": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "department": {
      "type": "string"
    },
    "inventory_count": {
      "type": "number"
    },
    "inventory_status": {
      "type": "string"
    },
    "inventory_source": {
      "type": "string"
    },
    "inventory_updated_at": {
      "type": "string"
    },
    "map_x": {
      "type": "number"
    },
    "map_y": {
      "type": "number"
    },
    "map_zone": {
      "type": "string"
    },
    "map_verified": {
      "type": "boolean"
    },
    "geofence_latitude": {
      "type": "number"
    },
    "geofence_longitude": {
      "type": "number"
    },
    "geofence_radius_meters": {
      "type": "number",
      "default": 1.5
    },
    "store_api_source": {
      "type": "string"
    },
    "store_api_sync_status": {
      "type": "string"
    },
    "store_api_last_sync": {
      "type": "string"
    },
    "driver_reports_count": {
      "type": "number",
      "default": 0
    },
    "confidence_weight_total": {
      "type": "number",
      "default": 0
    },
    "last_driver_report": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "report_count": {
      "type": "number"
    }
  },
  "required": [
