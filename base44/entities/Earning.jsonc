{
  "name": "Earning",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "zone": {
      "type": "string",
      "description": "Delivery zone this income was earned in (e.g. a LOKIN hotspot zone name)."
    },
    "vehicle": {
      "type": "string",
      "enum": [
        "car",
        "motorcycle",
        "cargo_van",
        "box_truck",
        "other"
      ],
      "description": "Vehicle these earnings were made with, so per-vehicle $/hr can be compared."
    },
    "base_pay": {
      "type": "number",
      "default": 0
    },
    "tips": {
      "type": "number",
      "default": 0
    },
    "bonuses": {
      "type": "number",
      "default": 0
    },
    "adjustments": {
      "type": "number",
      "default": 0
    },
    "trips": {
      "type": "number",
      "default": 0
    },
    "miles": {
      "type": "number",
      "default": 0
    },
    "platform": {
      "type": "string",
      "default": "mixed"
    },
    "category": {
      "type": "string",
      "enum": [
        "food_pickup",
        "grocery_shop_deliver",
        "grocery_pickup",
        "retail",
        "package",
        "alcohol",
        "pharmacy",
        "mixed"
      ],
      "default": "mixed",
      "description": "Order type these earnings came from (food, grocery, package, etc.) so historical earnings can be filtered and compared by category."
    }
  },
  "required": [
    "date",
    "amount"
  ]
}