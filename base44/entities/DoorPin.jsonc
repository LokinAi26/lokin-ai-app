{"name":"DoorPin","properties":{"accuracy_m":{"description":"GPS accuracy in meters at capture time, when known","type":"number"},"address_key":{"description":"Normalized address key (lowercased, unit designators stripped) used for lookup","type":"string"},"confirmations":{"default":1,"description":"How many times this pin has been saved/confirmed","type":"number"},"display_address":{"description":"Human-readable address as the driver entered it","type":"string"},"latitude":{"type":"number"},"longitude":{"type":"number"},"note":{"type":"string"},"source":{"default":"auto","description":"manual = driver stood at the door and pinned it; auto = captured where the delivery was marked complete","enum":["manual","auto"],"type":"string"}},"required":["address_key","latitude","longitude"],"type":"object"}