{
  "name": "DriverOAuthCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "uber_eats"
      ]
    },
    "token_ciphertext": {
      "type": "string",
      "description": "AES-GCM encrypted OAuth token bundle. Never returned to clients."
    },
    "token_iv": {
      "type": "string",
      "description": "Base64url AES-GCM IV for token_ciphertext."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "expired",
        "revoked",
        "error"
      ],
      "default": "connected"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "provider",
    "token_ciphertext",
    "token_iv",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}