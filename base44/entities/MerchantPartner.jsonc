{
  "name": "MerchantPartner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pilot_status": {
      "type": "string",
      "enum": [
        "lead",
        "interested",
        "onboarding",
        "pilot_ready",
        "active",
        "paused"
      ],
      "default": "interested"
    },
    "regulated_cannabis_enabled": {
      "type": "boolean",
      "default": false
    },
    "tobacco_nicotine_enabled": {
      "type": "boolean",
      "default": false
    },
    "non_controlled_pilot_enabled": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}