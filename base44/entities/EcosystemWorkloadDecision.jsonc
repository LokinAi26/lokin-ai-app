{
  "name": "EcosystemWorkloadDecision",
  "type": "object",
  "properties": {
    "workload_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "source_app": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "workload_type": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "engine_id": {
      "type": "string",
      "enum": [
        "pulse",
        "forge",
        "atlas",
        "sentinel",
        "governor"
      ]
    },
    "engine_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "admitted",
        "admitted_failover",
        "running",
        "completed",
        "failed",
        "cancelled",
        "deferred",
        "duplicate"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "priority": {
      "type": "number"
    },
    "score": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "lease_ms": {
      "type": "number"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "retry_after_ms": {
      "type": "number"
    },
    "actual_cost": {
      "type": "number"
    },
    "error": {
      "type": "string"
    },
    "decision_version": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workload_id",
    "idempotency_key",
    "source_app",
    "status",
    "accepted",
    "reason",
    "decision_version",
    "decided_at"
  ]
}