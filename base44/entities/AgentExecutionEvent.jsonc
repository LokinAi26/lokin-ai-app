{
  "name": "AgentExecutionEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SESSION_CREATED",
        "ACTION_REQUESTED",
        "ACTION_DECIDED",
        "SESSION_FROZEN",
        "SESSION_REVOKED",
        "SESSION_COMPLETED"
      ]
    },
    "capability": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "FREEZE",
        "INFO"
      ]
    },
    "reason": {
      "type": "string"
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "session_id",
    "owner_user_id",
    "event_type",
    "decision",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}