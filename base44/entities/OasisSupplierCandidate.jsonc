{
  "name": "OasisSupplierCandidate",
  "type": "object",
  "description": "Non-binding supplier catalog candidate for an OASIS product specification",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "product_spec_id": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "supplier_product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "product_image_url": {
      "type": "string"
    },
    "match_status": {
      "type": "string",
      "enum": [
        "needs_catalog_match",
        "candidate",
        "verified",
        "unavailable",
        "rejected"
      ],
      "default": "needs_catalog_match"
    },
    "live_match_score": {
      "type": "number",
      "default": 0
    },
    "estimated_base_cost": {
      "type": "number"
    },
    "estimated_shipping": {
      "type": "number"
    },
    "landed_cost": {
      "type": "number"
    },
    "estimated_margin_percent": {
      "type": "number"
    },
    "cost_verified": {
      "type": "boolean",
      "default": false
    },
    "inventory_verified": {
      "type": "boolean",
      "default": false
    },
    "quality_verified": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "catalog_checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "product_spec_id",
    "supplier",
    "match_status"
  ]
}