{
  "name": "PhysicalCapabilityDecision",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_CONFIRMATION",
        "REQUIRE_HARDWARE_AUTH"
      ]
    },
    "reason": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "context": {
      "type": "object"
    },
    "details": {
      "type": "object"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "request_id",
    "owner_user_id",
    "capability",
    "decision",
    "reason",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "data.owner_user_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_user_id": "{{user.id}}"
    }
  }
}