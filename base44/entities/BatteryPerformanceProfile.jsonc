{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "adaptive",
        "performance",
        "balanced",
        "battery_saver"
      ]
    },
    "low_battery_threshold": {
      "type": "number"
    },
    "pause_nonessential_when_hidden": {
      "type": "boolean"
    },
    "reduce_animation_in_saver": {
      "type": "boolean"
    },
    "reduce_polling_in_saver": {
      "type": "boolean"
    },
    "preserve_dashcam_priority": {
      "type": "boolean"
    },
    "preserve_navigation_priority": {
      "type": "boolean"
    },
    "preserve_voice_priority": {
      "type": "boolean"
    },
    "last_recommended_mode": {
      "type": "string"
    },
    "last_reason": {
      "type": "string"
    },
    "updated_at_client": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "BatteryPerformanceProfile"
}