{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "learning_enabled": {
      "type": "boolean"
    },
    "preferred_response_style": {
      "type": "string"
    },
    "strategy_summary": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "total_events": {
      "type": "integer",
      "minimum": 0
    },
    "last_learned_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "LokinLearningProfile"
}