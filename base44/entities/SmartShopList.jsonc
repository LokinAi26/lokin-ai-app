{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "abandoned"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "optimized_route": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "SmartShopList"
}