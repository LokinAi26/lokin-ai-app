{
  "name": "OasisProject",
  "type": "object",
  "description": "LOKIN OASIS idea-to-profit project",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Owning organization boundary"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owning Base44 user"
    },
    "title": {
      "type": "string"
    },
    "idea": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "target_price": {
      "type": "number"
    },
    "target_margin": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "concept",
        "design",
        "brand_review",
        "production_review",
        "sample",
        "final_approval",
        "storefront",
        "campaign",
        "selling",
        "profit_analysis",
        "scale",
        "improve",
        "retired"
      ],
      "default": "idea"
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "blocked"
      ],
      "default": "draft"
    },
    "brand_score": {
      "type": "number",
      "default": 0
    },
    "production_score": {
      "type": "number",
      "default": 0
    },
    "demand_score": {
      "type": "number",
      "default": 0
    },
    "profit_score": {
      "type": "number",
      "default": 0
    },
    "next_action": {
      "type": "string"
    },
    "director_summary": {
      "type": "string"
    },
    "design_direction": {
      "type": "string"
    },
    "production_plan": {
      "type": "string"
    },
    "demand_thesis": {
      "type": "string"
    },
    "risk_review": {
      "type": "string"
    },
    "recommended_price": {
      "type": "number"
    },
    "estimated_unit_cost": {
      "type": "number"
    },
    "estimated_contribution_profit": {
      "type": "number"
    },
    "director_provider": {
      "type": "string"
    },
    "director_model": {
      "type": "string"
    },
    "director_analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "idea",
    "status",
    "created_at"
  ]
}