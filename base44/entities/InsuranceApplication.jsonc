{
  "name": "InsuranceApplication",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "coverage_type": {
      "type": "string",
      "enum": [
        "commercial_gig",
        "auto_personal",
        "cargo",
        "health_gap",
        "roadside"
      ],
      "default": "commercial_gig"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "approved",
        "active",
        "declined",
        "renewed"
      ],
      "default": "submitted"
    },
    "vehicle_year": {
      "type": "number"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "personal_car",
        "cargo_van",
        "box_truck",
        "other"
      ],
      "default": "personal_car"
    },
    "license_number": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date"
    },
    "provider": {
      "type": "string"
    },
    "monthly_premium": {
      "type": "number",
      "default": 0
    },
    "policy_number": {
      "type": "string"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "deductible": {
      "type": "number",
      "default": 0
    },
    "liability_limit": {
      "type": "number",
      "default": 1000000
    },
    "notes": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "coverage_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}