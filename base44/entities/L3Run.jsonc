{
  "name": "L3Run",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "run_key": {
      "type": "string",
      "description": "Idempotency key for this execution run."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "ended",
        "stuck"
      ],
      "default": "open"
    },
    "log_json": {
      "type": "string",
      "description": "Append-only execution log: [{at, entry}]. Capped at the last 50 entries."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "plan_id",
    "user_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}