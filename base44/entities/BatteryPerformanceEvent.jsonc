{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "mode_changed",
        "low_battery",
        "charging_changed",
        "hidden",
        "visible",
        "optimization_applied"
      ]
    },
    "mode": {
      "type": "string"
    },
    "battery_level": {
      "type": "number"
    },
    "charging": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "event_type",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "BatteryPerformanceEvent"
}