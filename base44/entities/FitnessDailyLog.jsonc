      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "steps": {
      "type": "number"
    },
    "active_minutes": {
      "type": "number"
    },
    "water_oz": {
      "type": "number"
    },
    "sleep_hours": {
      "type": "number"
    },
    "energy_level": {
      "type": "number"
    },
    "recovery_score": {
      "type": "number"
    },
    "workout_completed": {
      "type": "boolean"
    },
    "driver_breaks": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
