{
  "name": "PrintfulConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 app user id who owns this Printful OAuth connection."
    },
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "number",
      "description": "UNIX timestamp (seconds) when the access_token expires."
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "store_type": {
      "type": "string"
    },
    "scopes": {
      "type": "string",
      "description": "OAuth scopes granted by the user, as returned by Printful."
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "connected"
    },
    "last_error": {
      "type": "string"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "access_token",
    "refresh_token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}