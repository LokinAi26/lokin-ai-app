{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "primary_goal": {
      "type": "string",
      "enum": [
        "general_fitness",
        "fat_loss",
        "muscle_gain",
        "strength",
        "endurance",
        "mobility",
        "driver_wellness"
      ]
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "preferred_workouts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available_equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workout_minutes_target": {
      "type": "number"
    },
    "weekly_workout_target": {
      "type": "number"
    },
    "daily_steps_target": {
      "type": "number"
    },
    "daily_water_oz_target": {
      "type": "number"
    },
    "fitness_mode_enabled": {
      "type": "boolean"
    },
    "updated_at_client": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "FitnessProfile"
}