{
  "name": "OpportunityScan",
  "type": "object",
  "properties": {
    "scan_date": {
      "type": "string",
      "format": "date",
      "description": "Date the scan ran."
    },
    "region": {
      "type": "string",
      "default": "Hampton Roads"
    },
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "description": "Official platform or employer name, e.g. DoorDash, Uber Eats, FedEx Ground."
    },
    "category": {
      "type": "string",
      "enum": [
        "gig_app",
        "w2_driver",
        "courier_1099",
        "medical_courier",
        "package_courier",
        "cannabis_delivery",
        "alcohol_delivery",
        "warehouse",
        "other"
      ],
      "default": "other"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "personal_car",
        "cargo_van",
        "box_truck",
        "any"
      ],
      "default": "any"
    },
    "pay": {
      "type": "string",
      "description": "Publicly listed pay, e.g. $25/hr, $200/day, per-delivery."
    },
    "pay_amount": {
      "type": "number",
      "description": "Normalized hourly/daily dollar figure for sorting (best estimate)."
    },
    "pay_source": {
      "type": "string",
      "enum": [
        "advertised",
        "estimated",
        "user_reported"
      ],
      "default": "advertised",
      "description": "How the pay figure was sourced \u2014 never a guarantee."
    },
    "pay_basis": {
      "type": "string",
      "enum": [
        "hourly",
        "per_delivery",
        "per_trip",
        "per_mile",
        "daily",
        "weekly",
        "salary"
      ],
      "default": "hourly"
    },
    "employment_type": {
      "type": "string",
      "description": "W-2, 1099, gig, contract, etc."
    },
    "schedule": {
      "type": "string",
      "enum": [
        "flexible",
        "fixed_shifts",
        "on_demand",
        "part_time",
        "full_time"
      ],
      "default": "flexible"
    },
    "est_weekly_hours": {
      "type": "number",
      "default": 0,
      "description": "Estimated hours/week a typical driver works this role."
    },
    "est_weekly_miles": {
      "type": "number",
      "default": 0,
      "description": "Estimated miles/week driven for this role."
    },
    "vehicle_requirements": {
      "type": "string"
    },
    "qualifications": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "apply_url": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date",
      "description": "Date the listing details were last verified."
    },
    "notes": {
      "type": "string"
    },
    "is_new": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "category"
  ]
}