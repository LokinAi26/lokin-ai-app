{
  "type": "object",
  "description": "Provider-neutral capability and health registry; credentials are never stored here",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "enum": [
        "raster",
        "vector",
        "apparel_3d",
        "video",
        "audio",
        "upscale",
        "mastering"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "local",
        "cloud_worker",
        "external_api",
        "desktop_bridge"
      ]
    },
    "setup_status": {
      "type": "string",
      "enum": [
        "setup_required",
        "configured",
        "degraded",
        "disabled"
      ],
      "default": "setup_required"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "offline"
      ],
      "default": "unknown"
    },
    "supports_async": {
      "type": "boolean",
      "default": true
    },
    "max_concurrency": {
      "type": "integer",
      "default": 0,
      "minimum": 0
    },
    "estimated_unit_cost_usd": {
      "type": "number",
      "default": 0,
      "minimum": 0
    },
    "configuration_json": {
      "type": "string"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provider_key",
    "display_name",
    "capability",
    "execution_mode",
    "setup_status",
    "health_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "OasisProviderCapability"
}