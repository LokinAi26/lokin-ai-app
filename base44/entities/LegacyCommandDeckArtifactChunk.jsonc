{
  "type": "object",
  "name": "LegacyCommandDeckArtifactChunk",
  "description": "Chunked base64 payload for a Legacy Command Deck project artifact",
  "properties": {
    "project_key": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "chunk_index": {
      "type": "number"
    },
    "chunk_count": {
      "type": "number"
    },
    "data_base64": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_key",
    "version",
    "chunk_index",
    "chunk_count",
    "data_base64",
    "sha256",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}