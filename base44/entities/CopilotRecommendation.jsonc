{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "context": {
      "type": "string",
      "enum": [
        "pre_shift",
        "active_drive",
        "shopping",
        "pickup",
        "dropoff",
        "break",
        "post_shift"
      ]
    },
    "recommendation_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "priority": {
      "type": "number"
    },
    "action_route": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "shown",
        "accepted",
        "dismissed",
        "expired"
      ]
    },
    "created_at_client": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "context",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "CopilotRecommendation"
}