{
  "name": "OasisAssetLineage",
  "type": "object",
  "description": "Append-only provenance edge connecting OASIS inputs, jobs, models, approvals, and outputs",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "parent_asset_id": {
      "type": "string"
    },
    "output_asset_id": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "derived_from",
        "version_of",
        "upscaled_from",
        "vectorized_from",
        "simulated_from",
        "edited_from",
        "mastered_from"
      ]
    },
    "provider_key": {
      "type": "string"
    },
    "model_key": {
      "type": "string"
    },
    "workflow_key": {
      "type": "string"
    },
    "workflow_version": {
      "type": "integer"
    },
    "seed": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string"
    },
    "input_hash": {
      "type": "string"
    },
    "output_hash": {
      "type": "string"
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "clear",
        "blocked"
      ],
      "default": "unreviewed"
    },
    "approval_id": {
      "type": "string"
    },
    "metadata_json": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_user_id",
    "project_id",
    "job_id",
    "relationship",
    "workflow_key",
    "workflow_version",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}