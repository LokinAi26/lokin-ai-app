{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "declined",
        "saved",
        "expired"
      ]
    },
    "score_at_decision": {
      "type": "number"
    },
    "confidence_at_decision": {
      "type": "number",
      "description": "SEAL data-confidence percentage when the driver made the decision."
    },
    "seal_version": {
      "type": "string",
      "description": "Version of the deterministic SEAL scoring policy."
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "strong_match",
        "consider",
        "low_match",
        "avoid"
      ]
    },
    "factor_scores": {
      "type": "object",
      "description": "Explainable economics, goal, mileage, vehicle, freshness, and source factor scores."
    },
    "driver_authorized": {
      "type": "boolean",
      "default": false,
      "description": "True only after an explicit driver action."
    },
    "reason": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "opportunity_id",
    "decision"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "OpportunityDecision"
}