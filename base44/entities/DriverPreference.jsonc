{
  "name": "DriverPreference",
  "type": "object",
  "properties": {
    "user_type": {
      "type": "string",
      "enum": [
        "driver",
        "trucker",
        "traveler"
      ],
      "default": "driver"
    },
    "accepted_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "food_pickup",
        "grocery_shop_deliver",
        "grocery_pickup",
        "retail",
        "package"
      ]
    },
    "work_filters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "active_modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "delivery"
      ]
    },
    "work_status": {
      "type": "string",
      "enum": [
        "off",
        "working",
        "paused"
      ],
      "default": "off"
    },
    "optimization_mode": {
      "type": "string",
      "enum": [
        "fastest",
        "most_profit",
        "most_money",
        "goal_mode",
        "low_stress",
        "minimum_mileage",
        "homeward"
      ],
      "default": "most_profit"
    },
    "min_payout": {
      "type": "number",
      "default": 6
    },
    "max_miles": {
      "type": "number",
      "default": 12
    },
    "min_per_hour": {
      "type": "number",
      "default": 22
    },
    "mileage_cost": {
      "type": "number",
      "default": 0.67
    },
    "vehicle_mpg": {
      "type": "number",
      "default": 26
    },
    "gas_price": {
      "type": "number",
      "default": 3.45
    },
    "daily_goal": {
      "type": "number",
      "default": 150
    },
    "weekly_goal": {
      "type": "number",
      "default": 850
    },
    "daily_hours_goal": {
      "type": "number",
      "default": 8
    },
    "stock_alert_enabled": {
      "type": "boolean",
      "default": false
    },
    "stock_alert_threshold": {
      "type": "number",
      "default": 5
    },
    "stock_alert_email": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "personal_car",
        "cargo_van",
        "box_truck",
        "other"
      ],
      "default": "personal_car",
      "description": "Driver's vehicle class, used to match against opportunity role_type."
    },
    "region": {
      "type": "string",
      "default": "",
      "description": "Driver's working region (e.g. Hampton Roads), used to match against opportunity region."
    },
    "alert_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Opt-in to automatic alerts when a new opportunity matches this driver's location and vehicle."
    }
  },
  "required": []
}