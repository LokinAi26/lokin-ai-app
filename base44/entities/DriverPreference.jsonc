{
  "name": "DriverPreference",
  "type": "object",
  "properties": {
    "user_type": {
      "type": "string",
      "enum": [
        "driver",
        "trucker",
        "traveler"
      ],
      "default": "driver"
    },
    "accepted_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "food_pickup",
        "grocery_shop_deliver",
        "grocery_pickup",
        "retail",
        "package"
      ]
    },
    "work_filters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "active_modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "delivery"
      ]
    },
    "work_status": {
      "type": "string",
      "enum": [
        "off",
        "working",
        "paused"
      ],
      "default": "off"
    },
    "optimization_mode": {
      "type": "string",
      "enum": [
        "fastest",
        "most_profit",
        "most_money",
        "goal_mode",
        "low_stress",
        "minimum_mileage",
        "homeward"
      ],
      "default": "most_profit"
    },
    "min_payout": {
      "type": "number",
      "default": 6
    },
    "max_miles": {
      "type": "number",
      "default": 12
    },
    "min_per_hour": {
      "type": "number",
      "default": 22
    },
    "mileage_cost": {
      "type": "number",
      "default": 0.67
    },
    "vehicle_mpg": {
      "type": "number",
      "default": 26
    },
    "gas_price": {
      "type": "number",
      "default": 3.45
    },
    "daily_goal": {
      "type": "number",
      "default": 150
    },
    "weekly_goal": {
      "type": "number",
      "default": 850
    },
    "daily_hours_goal": {
      "type": "number",
      "default": 8
    }
  }
}