{
  "name": "PrintfulShipment",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "tracking": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "order_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}