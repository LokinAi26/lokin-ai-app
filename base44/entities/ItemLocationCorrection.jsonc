{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "item_key": {
      "type": "string"
    },
    "reported_aisle": {
      "type": "string"
    },
    "reported_shelf": {
      "type": "string"
    },
    "map_x": {
      "type": "number"
    },
    "map_y": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ]
    },
    "created_at_client": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "store_id",
    "item_key",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "ItemLocationCorrection"
}