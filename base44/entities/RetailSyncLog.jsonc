{
  "type": "object",
  "properties": {
    "retailer_connection_id": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "sync_type": {
      "type": "string",
      "enum": [
        "inventory",
        "layout",
        "catalog",
        "full"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "records_received": {
      "type": "number"
    },
    "records_updated": {
      "type": "number"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "retailer_connection_id",
    "sync_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "RetailSyncLog"
}