{
  "name": "SealDecision",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "decision_key": {
      "type": "string",
      "description": "Idempotency key for one SEAL evaluation."
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "offer",
        "route",
        "hotspot",
        "opportunity"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "TAKE",
        "CONSIDER",
        "PASS"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "projected_gross": {
      "type": "number"
    },
    "projected_net": {
      "type": "number"
    },
    "projected_net_per_hour": {
      "type": "number"
    },
    "projected_net_per_mile": {
      "type": "number"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sense_snapshot": {
      "type": "object"
    },
    "evaluation_snapshot": {
      "type": "object"
    },
    "engine_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "driver_confirmation_required": {
      "type": "boolean",
      "default": true
    },
    "created_at_external": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "decision_key",
    "subject_type",
    "subject_id",
    "action",
    "score",
    "confidence",
    "engine_version",
    "policy_version"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}