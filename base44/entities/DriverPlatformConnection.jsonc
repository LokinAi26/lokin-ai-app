{
  "name": "DriverPlatformConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform_name": {
      "type": "string"
    },
    "connection_type": {
      "type": "string",
      "enum": [
        "official_oauth",
        "partner",
        "manual",
        "import"
      ]
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "oauth_limited_access",
        "marketplace_partner",
        "connect_partner",
        "manual_until_official"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "approval_required",
        "pending_authorization",
        "connected",
        "manual_only",
        "expired",
        "error",
        "disconnected",
        "unsupported"
      ],
      "default": "disconnected"
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "not_requested",
        "required",
        "pending",
        "approved",
        "not_available"
      ],
      "default": "required"
    },
    "authorization_state": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "authorized",
        "expired",
        "revoked",
        "unavailable"
      ],
      "default": "not_started"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "can_sync_profile": {
      "type": "boolean",
      "default": false
    },
    "can_sync_trips": {
      "type": "boolean",
      "default": false
    },
    "can_sync_payments": {
      "type": "boolean",
      "default": false
    },
    "can_ingest_live_offers": {
      "type": "boolean",
      "default": false
    },
    "can_ingest_partner_orders": {
      "type": "boolean",
      "default": false
    },
    "data_disclosure": {
      "type": "string"
    },
    "external_account_ref": {
      "type": "string",
      "description": "Non-secret provider account reference. OAuth tokens and secrets must never be stored here."
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "platform_name",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}