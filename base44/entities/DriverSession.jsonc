{
  "name": "DriverSession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "working",
        "paused",
        "ended"
      ],
      "default": "working"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "resumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "default": "voice"
    },
    "notes": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food_pickup",
        "grocery_shop_deliver",
        "grocery_pickup",
        "retail",
        "package",
        "alcohol",
        "pharmacy",
        "mixed"
      ],
      "default": "mixed",
      "description": "Delivery category tag for this session, used for category profitability analytics."
    },
    "miles": {
      "type": "number",
      "default": 0,
      "description": "GPS-tracked miles driven during this session."
    },
    "earnings": {
      "type": "number",
      "default": 0,
      "description": "Gross earnings logged during this session."
    }
  },
  "required": [
    "user_id",
    "status",
    "started_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}