{
  "name": "RegulatedDelivery",
  "type": "object",
  "properties": {
    "driver_user_id": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "alcohol",
        "tobacco_nicotine",
        "cannabis_future"
      ],
      "default": "alcohol"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "pickup_verified",
        "in_transit",
        "age_check_required",
        "delivered",
        "refused",
        "returned",
        "incident"
      ],
      "default": "created"
    },
    "customer_age_verified": {
      "type": "boolean",
      "default": false
    },
    "id_check_method": {
      "type": "string"
    },
    "sealed_order_confirmed": {
      "type": "boolean",
      "default": false
    },
    "return_required": {
      "type": "boolean",
      "default": false
    },
    "created_at_local": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.driver_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.driver_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.driver_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}