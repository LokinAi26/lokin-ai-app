{
  "name": "OasisProfitSnapshot",
  "type": "object",
  "description": "Truthful contribution-profit measurement",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "production_cost": {
      "type": "number",
      "default": 0
    },
    "shipping_subsidy": {
      "type": "number",
      "default": 0
    },
    "transaction_fees": {
      "type": "number",
      "default": 0
    },
    "returns_cost": {
      "type": "number",
      "default": 0
    },
    "advertising_cost": {
      "type": "number",
      "default": 0
    },
    "royalties": {
      "type": "number",
      "default": 0
    },
    "contribution_profit": {
      "type": "number",
      "default": 0
    },
    "margin_percent": {
      "type": "number",
      "default": 0
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "captured_at"
  ]
}