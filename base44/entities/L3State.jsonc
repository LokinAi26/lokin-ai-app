{
  "name": "L3State",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "state_key": {
      "type": "string",
      "description": "Watermark / seen-list key, e.g. shakedown_watermark."
    },
    "value_json": {
      "type": "string",
      "description": "Durable state value so recurring jobs stay idempotent."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "state_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}