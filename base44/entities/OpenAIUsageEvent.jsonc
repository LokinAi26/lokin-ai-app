{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "provider_error"
      ]
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "model",
    "mode",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "name": "OpenAIUsageEvent"
}