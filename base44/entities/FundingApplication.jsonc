{
  "type": "object",
  "description": "LOKIN funding and government-vendor application execution record",
  "properties": {
    "program_key": {
      "type": "string"
    },
    "target_product": {
      "type": "string",
      "enum": [
        "lokin_ai",
        "lokin_productions",
        "both"
      ]
    },
    "application_stage": {
      "type": "string",
      "enum": [
        "concept",
        "project_pitch",
        "full_proposal",
        "vendor_registration",
        "certification",
        "grant_application",
        "contract_bid",
        "investment_review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "preparing",
        "blocked",
        "ready",
        "submitted",
        "awarded",
        "declined"
      ],
      "default": "not_started"
    },
    "requested_amount_usd": {
      "type": "number",
      "minimum": 0
    },
    "due_date": {
      "type": "string"
    },
    "readiness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "technical_narrative": {
      "type": "string"
    },
    "rd_scope": {
      "type": "string"
    },
    "virginia_impact": {
      "type": "string"
    },
    "budget_status": {
      "type": "string",
      "enum": [
        "not_started",
        "draft",
        "reviewed",
        "final"
      ],
      "default": "not_started"
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "incomplete",
        "partial",
        "ready"
      ],
      "default": "incomplete"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "program_key",
    "target_product",
    "application_stage",
    "status",
    "readiness_score"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "FundingApplication"
}